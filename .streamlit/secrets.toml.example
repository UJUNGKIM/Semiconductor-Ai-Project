# SHAPGPT Google 로그인 설정 예시입니다. 값은 모두 자리표시자입니다.
# 실제 값은 배포 플랫폼의 Secrets 설정이나 로컬 .streamlit/secrets.toml에만
# 넣으세요. .streamlit/secrets.toml은 .gitignore로 Git에서 제외됩니다.
# 로그인을 강제하려면 환경 변수 SHAPGPT_REQUIRE_LOGIN=1도 함께 설정합니다.

[auth]
# Google Cloud 콘솔의 OAuth 클라이언트에 같은 주소를 승인된 리디렉션 URI로 등록합니다.
redirect_uri = "https://<배포-주소>/oauth2callback"
# 32자 이상의 임의 문자열. 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
cookie_secret = "<임의로 생성한 긴 문자열>"

[auth.google]
client_id = "<Google OAuth 클라이언트 ID>"
client_secret = "<Google OAuth 클라이언트 보안 비밀번호>"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[shapgpt]
# 관리자 허용 목록. Google이 인증한 이메일(email_verified=true)만 인정합니다.
admin_emails = ["<관리자 Google 이메일>"]
# 이메일 대신 발급자|주체(iss|sub)로 지정할 수도 있습니다.
# admin_subjects = ["https://accounts.google.com|<Google 계정 sub 값>"]
